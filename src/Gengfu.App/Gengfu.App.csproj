<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Gengfu.Core\Gengfu.Core.csproj" />
    <ProjectReference Include="..\Gengfu.TeamSpeak\Gengfu.TeamSpeak.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The Fluent theme API is still experimental; accepted in ADR-0001. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Speech and audio files call Windows through its method tables (ADR-0005). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gengfu.App.Tests" />
  </ItemGroup>

  <!-- XAML reads the strings through {x:Static}, which sees only public members. -->
  <ItemGroup>
    <EmbeddedResource Update="Strings\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Gengfu.App</StronglyTypedNamespace>
      <StronglyTypedManifestPrefix>Gengfu.App.Strings</StronglyTypedManifestPrefix>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Draw text selection inside each text box, under its clip and with its own text colour; the
       default adorner paints over the clock's digits and past the edges of their field. The digits
       set their selection colours; Settings' text boxes keep the theme's, which read well in light
       and dark. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" />
  </ItemGroup>

  <!-- The window draws its own title bar on the flat surface colour. The Fluent theme's Mica backdrop
       would extend Windows' frame under it, and Windows would draw its caption buttons there too. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop" Value="true" />
  </ItemGroup>

  <!-- The markup compiler first builds a temporary assembly from the code alone, before resources,
       so the strings class has to exist by then. In the real build this target finds it done. -->
  <Target Name="GenerateStringsBeforeCompile" BeforeTargets="CoreCompile" DependsOnTargets="PrepareResourceNames;ResGen" />

</Project>
