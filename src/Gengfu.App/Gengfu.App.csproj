<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Gengfu.Core\Gengfu.Core.csproj" />
    <ProjectReference Include="..\Gengfu.TeamSpeak\Gengfu.TeamSpeak.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The Fluent theme API is still experimental; accepted in ADR-0001. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Speech and audio files call Windows through its method tables (ADR-0005). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Gengfu.exe: the name Task Manager, the install folder and Windows' prompts show. -->
    <AssemblyName>Gengfu</AssemblyName>
    <!-- Velopack's install and update hooks run before WPF starts, from Program.Main (ADR-0006). -->
    <StartupObject>Gengfu.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <!-- Pinned with the vpk tool in release.yml: the two must match. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gengfu.App.Tests" />
  </ItemGroup>

  <!-- The licenses of what Gengfu ships go beside Gengfu.exe. A self-contained build ships .NET as
       well, so it takes .NET's license and notices from the runtime pack it was built with. -->
  <ItemGroup>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PublishDotNetNotices" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <DotNetNotices Include="%(ResolvedRuntimePack.PackageDirectory)\LICENSE.TXT;%(ResolvedRuntimePack.PackageDirectory)\THIRD-PARTY-NOTICES.TXT" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Error Condition="'@(DotNetNotices->Count())' != '2'" Text="The .NET runtime pack's license and notices weren't found." />
    <Copy SourceFiles="@(DotNetNotices)" DestinationFolder="$(PublishDir)dotnet" />
  </Target>

  <!-- XAML reads the strings through {x:Static}, which sees only public members. -->
  <ItemGroup>
    <EmbeddedResource Update="Strings\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Gengfu.App</StronglyTypedNamespace>
      <StronglyTypedManifestPrefix>Gengfu.App.Strings</StronglyTypedManifestPrefix>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Draw text selection inside each text box, under its clip and with its own text colour; the
       default adorner paints over the clock's digits and past the edges of their field. The digits
       set their selection colours; Settings' text boxes keep the theme's, which read well in light
       and dark. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" />
  </ItemGroup>

  <!-- The window draws its own title bar on the flat surface colour. The Fluent theme's Mica backdrop
       would extend Windows' frame under it, and Windows would draw its caption buttons there too. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop" Value="true" />
  </ItemGroup>

  <!-- The markup compiler first builds a temporary assembly from the code alone, before resources,
       so the strings class has to exist by then. In the real build this target finds it done. -->
  <Target Name="GenerateStringsBeforeCompile" BeforeTargets="CoreCompile" DependsOnTargets="PrepareResourceNames;ResGen" />

</Project>
