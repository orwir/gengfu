<Window x:Class="Gengfu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gengfu" Height="616" Width="380"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ClockHost" Margin="16,8,16,12" HorizontalAlignment="Center" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,12,12,12">
            <!-- One button for Start and Stop, so keyboard focus stays on it when it flips. -->
            <Button x:Name="StartStop" Height="32" Click="OnStartStop"
                    AutomationProperties.Name="{Binding Text, ElementName=StartStopText}">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="StartIcon" Width="16" Height="16" Data="M5,3.2 L5,12.8 L12.6,8 Z"
                          Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                    <Rectangle x:Name="StopIcon" Width="8" Height="8" Margin="4" RadiusX="1.5" RadiusY="1.5"
                               Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="StartStopText" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
