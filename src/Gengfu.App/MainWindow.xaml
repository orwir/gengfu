<Window x:Class="Gengfu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gengfu" Width="380" Height="616" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Gengfu draws its own title bar, so it can hold Settings' way back and leave out maximize, which
         Windows' own shows greyed out on a window that can still be minimized. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Style="{StaticResource BackButton}" Click="OnBack">
                <Path Style="{StaticResource Icon}" Data="M13,8 L3,8 M7,4 L3,8 L7,12" />
            </Button>
            <!-- The mark: a gong on its stand, in the Windows accent. -->
            <Canvas x:Name="AppIcon" Width="16" Height="16" Margin="14,0,10,0" VerticalAlignment="Center">
                <Path Data="M8,1.5 L8,3.75" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1.5">
                    <Path.Data>
                        <EllipseGeometry Center="8,9.25" RadiusX="5.25" RadiusY="5.25" />
                    </Path.Data>
                </Path>
                <Path Fill="{DynamicResource AccentFillColorDefaultBrush}">
                    <Path.Data>
                        <EllipseGeometry Center="8,9.25" RadiusX="1.75" RadiusY="1.75" />
                    </Path.Data>
                </Path>
            </Canvas>
            <TextBlock x:Name="Caption" Grid.Column="1" FontSize="12" VerticalAlignment="Center" />
            <Button x:Name="MinimizeButton" Grid.Column="2" Style="{StaticResource CaptionButton}" Click="OnMinimize">
                <Path Data="M0,5.5 L10,5.5" Width="10" Height="10" StrokeThickness="1"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CloseCaptionButton}" Click="OnClose">
                <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Width="10" Height="10" StrokeThickness="1"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Button>
        </Grid>

        <ContentControl x:Name="Page" Grid.Row="1" Focusable="False" />
    </Grid>
</Window>
