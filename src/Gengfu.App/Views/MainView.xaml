<UserControl x:Class="Gengfu.App.Views.MainView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Gengfu.App">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Left-aligned, so the link follows the words, and the words give way when the line runs long. -->
        <DockPanel Height="20" Margin="16,4,16,0" HorizontalAlignment="Left">
            <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="8" Height="8" StrokeThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center" />
            <Button x:Name="StatusLink" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Height="20" Padding="4,0" Margin="4,0,0,0"
                    FontSize="12" Content="{x:Static app:Strings.Settings}" Click="OnSettings" />
            <TextBlock x:Name="StatusText" FontSize="12" LineHeight="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="16,8,16,12">
            <Border x:Name="ClockHost" HorizontalAlignment="Center" />
            <TextBlock Margin="0,2,0,0" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run x:Name="NextText" /> <Run x:Name="NextValue" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </TextBlock>
        </StackPanel>

        <!-- As tall as its calls, up to the room left above the buttons; past that its calls scroll. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="16,16,16,0" Padding="0,8" VerticalAlignment="Top">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,4,16,8">
                    <TextBlock x:Name="CallsAhead" DockPanel.Dock="Right" FontSize="12" LineHeight="16" VerticalAlignment="Bottom" Margin="12,0,0,2"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Static app:Strings.Calls}" FontWeight="SemiBold" LineHeight="20" />
                </DockPanel>
                <ScrollViewer x:Name="CallsScroller" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="CallRows" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="16,12,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- One button for Start and Stop, so keyboard focus stays on it when it flips. -->
            <Button x:Name="StartStop" Height="32" Click="OnStartStop"
                    AutomationProperties.Name="{Binding Text, ElementName=StartStopText}">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="StartIcon" Width="16" Height="16" Data="M5,3.2 L5,12.8 L12.6,8 Z"
                          Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                    <Rectangle x:Name="StopIcon" Width="8" Height="8" Margin="4" RadiusX="1.5" RadiusY="1.5"
                               Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="StartStopText" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="TestButton" Grid.Column="2" Style="{StaticResource SubtleButton}" Margin="0,0,4,0" Click="OnTest"
                    AutomationProperties.Name="{Binding Text, ElementName=TestText}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="M2.5,6 L5,6 L8.5,3 L8.5,13 L5,10 L2.5,10 Z M11,5.5 A3.5,3.5 0 0 1 11,10.5" />
                    <TextBlock x:Name="TestText" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource SubtleButton}" Width="32" Padding="0" Click="OnSettings"
                    AutomationProperties.Name="{x:Static app:Strings.Settings}">
                <Canvas Width="16" Height="16">
                    <Path Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2.4" StrokeDashArray="0.9167 1.0467">
                        <Path.Data>
                            <EllipseGeometry Center="8,8" RadiusX="6" RadiusY="6" />
                        </Path.Data>
                    </Path>
                    <Path Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.4">
                        <Path.Data>
                            <EllipseGeometry Center="8,8" RadiusX="4.3" RadiusY="4.3" />
                        </Path.Data>
                    </Path>
                    <Path Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.3">
                        <Path.Data>
                            <EllipseGeometry Center="8,8" RadiusX="1.6" RadiusY="1.6" />
                        </Path.Data>
                    </Path>
                </Canvas>
            </Button>
        </Grid>
    </Grid>
</UserControl>
