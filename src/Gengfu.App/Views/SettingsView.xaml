<UserControl x:Class="Gengfu.App.Views.SettingsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Gengfu.App">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Shown in an empty field or an empty drop-down, which WPF's own controls can't do. -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="11,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
        </Style>
        <Style x:Key="Chevron" TargetType="Path">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Data" Value="M3,4.5 L6,7.5 L9,4.5" />
            <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Above the scroll, so a settings file with an error shows wherever Settings is scrolled. -->
        <Border x:Name="FileBar" Style="{StaticResource CautionBar}" Margin="16,8,16,4" Visibility="Collapsed">
            <DockPanel>
                <Canvas DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top">
                    <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                    <Path Data="M8,4.5 L8,8.75" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Ellipse Width="1.9" Height="1.9" Canvas.Left="7.05" Canvas.Top="10.15" Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Canvas>
                <StackPanel>
                    <TextBlock x:Name="FileErrorText" FontSize="12" LineHeight="16" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Button Style="{StaticResource LinkButton}" Height="20" Padding="0" Margin="0,4,0,0" FontSize="12"
                            HorizontalAlignment="Left" Content="{x:Static app:Strings.OpenSettingsFile}" Click="OnOpenSettingsFile" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="16,8,16,16">
                <TextBlock Style="{StaticResource Heading}" Text="TeamSpeak" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static app:Strings.ServerAddress}" />
                        <Grid>
                            <TextBox x:Name="ServerBox" AutomationProperties.Name="{x:Static app:Strings.ServerAddress}"
                                     TextChanged="OnServerChanged" KeyDown="OnLoginKey" />
                            <TextBlock x:Name="ServerPlaceholder" Style="{StaticResource Placeholder}" Text="ts.example.com" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="{x:Static app:Strings.ServerPassword}" />
                                <Grid>
                                    <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{x:Static app:Strings.ServerPassword}"
                                                 PasswordChanged="OnPasswordChanged" KeyDown="OnLoginKey" />
                                    <TextBlock x:Name="PasswordPlaceholder" Style="{StaticResource Placeholder}" Text="{x:Static app:Strings.Optional}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Label}" Text="{x:Static app:Strings.BotNickname}" />
                                <TextBox x:Name="NicknameBox" AutomationProperties.Name="{x:Static app:Strings.BotNickname}"
                                         TextChanged="OnNicknameChanged" KeyDown="OnLoginKey" />
                            </StackPanel>
                        </Grid>
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="ConnectButton" DockPanel.Dock="Left" Height="32" Padding="12,0" VerticalAlignment="Top" Click="OnConnect" />
                            <Ellipse x:Name="ConnectionDot" DockPanel.Dock="Left" Width="8" Height="8" StrokeThickness="1.5" Margin="12,12,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="ConnectionText" FontSize="12" LineHeight="16" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Heading}" Margin="0,20,0,8" Text="{x:Static app:Strings.WhoHears}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="GroupRadio" GroupName="Listeners" VerticalAlignment="Center" Content="{x:Static app:Strings.AServerGroup}" Checked="OnListenersChecked" />
                            <Grid Grid.Column="1">
                                <ComboBox x:Name="GroupBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static app:Strings.AServerGroup}"
                                          DropDownOpened="OnGroupsOpened" SelectionChanged="OnGroupChosen" />
                                <TextBlock x:Name="GroupPlaceholder" Style="{StaticResource Placeholder}" Margin="12,0,28,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <RadioButton x:Name="ChannelsRadio" Grid.Row="2" GroupName="Listeners" VerticalAlignment="Center" Content="{x:Static app:Strings.ChosenChannels}" Checked="OnListenersChecked" />
                            <Button x:Name="ChannelsButton" Grid.Row="2" Grid.Column="1" Style="{StaticResource ContentButton}" Padding="11,0,8,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnChannelsOpen"
                                    AutomationProperties.Name="{x:Static app:Strings.ChosenChannels}">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Style="{StaticResource Chevron}" Margin="8,0,0,0" />
                                    <TextBlock x:Name="ChannelsText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                            <Popup x:Name="ChannelsPopup" Grid.Row="2" Grid.Column="1" PlacementTarget="{Binding ElementName=ChannelsButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" Closed="OnChannelsClosed" KeyDown="OnChannelsKey">
                                <Border Margin="0,4,12,12" Padding="4" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ChannelList" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <TextBlock x:Name="WhoNote" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Heading}" Margin="0,20,0,8" Text="{x:Static app:Strings.Calls}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ComboBox x:Name="LeadBox" DockPanel.Dock="Right" Width="168" AutomationProperties.Name="{x:Static app:Strings.CallAhead}" SelectionChanged="OnLeadChosen" />
                            <TextBlock Text="{x:Static app:Strings.CallAhead}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel x:Name="SpeechPanel">
                            <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4" Text="{x:Static app:Strings.Say}" />
                            <TextBox x:Name="SayBox" AutomationProperties.Name="{x:Static app:Strings.Say}" TextChanged="OnSayChanged" />
                            <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4" Text="{x:Static app:Strings.Voice}" />
                            <ComboBox x:Name="VoiceBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static app:Strings.Voice}"
                                      DropDownOpened="OnVoicesOpened" SelectionChanged="OnVoiceChosen" />
                        </StackPanel>
                        <StackPanel x:Name="FilePanel">
                            <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4" Text="{x:Static app:Strings.SoundFile}" />
                            <DockPanel>
                                <Button x:Name="ChangeFile" DockPanel.Dock="Right" Height="32" Padding="12,0" Margin="8,0,0,0" Content="{x:Static app:Strings.Change}" Click="OnChooseFile" />
                                <Border x:Name="FileBox" Height="32" Padding="10,0" CornerRadius="4" BorderThickness="1"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <DockPanel VerticalAlignment="Center">
                                        <Path DockPanel.Dock="Left" Style="{StaticResource Icon}"
                                              Data="M6,12 L6,3.5 L13,2 L13,10.5 M2.5,12 A1.75,1.75 0 1 0 6,12 A1.75,1.75 0 1 0 2.5,12 M9.5,10.5 A1.75,1.75 0 1 0 13,10.5 A1.75,1.75 0 1 0 9.5,10.5" />
                                        <TextBlock x:Name="FileName" Style="{StaticResource IconLabel}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                        </StackPanel>
                        <Border x:Name="SoundHint" Margin="0,12,0,0">
                            <DockPanel>
                                <Canvas DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <Ellipse x:Name="HintDisc" Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" />
                                    <Path x:Name="HintStem" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse x:Name="HintDot" Width="1.9" Height="1.9" Canvas.Left="7.05" />
                                </Canvas>
                                <StackPanel>
                                    <TextBlock x:Name="HintText" FontSize="12" LineHeight="16" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Button x:Name="HintLink" Style="{StaticResource LinkButton}" Height="20" Padding="0" Margin="0,4,0,0" FontSize="12"
                                            HorizontalAlignment="Left" Content="{x:Static app:Strings.OpenLanguageRegion}" Click="OnOpenLanguageRegion" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="TestButton" DockPanel.Dock="Left" Style="{StaticResource ContentButton}" Padding="12,0" Click="OnTest"
                                    AutomationProperties.Name="{Binding Text, ElementName=TestText}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Icon}" Data="M2.5,6 L5,6 L8.5,3 L8.5,13 L5,10 L2.5,10 Z M11,5.5 A3.5,3.5 0 0 1 11,10.5" />
                                    <TextBlock x:Name="TestText" Style="{StaticResource IconLabel}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SoundSwitch" Style="{StaticResource LinkButton}" Height="32" HorizontalAlignment="Right" Click="OnSoundSwitch" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Heading}" Margin="0,20,0,8" Text="{x:Static app:Strings.General}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="168" AutomationProperties.Name="{x:Static app:Strings.Language}" SelectionChanged="OnLanguageChosen" />
                            <TextBlock Text="{x:Static app:Strings.Language}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Width="168" AutomationProperties.Name="{x:Static app:Strings.Theme}" SelectionChanged="OnThemeChosen" />
                            <TextBlock Text="{x:Static app:Strings.Theme}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Height="32"
                                    Content="{x:Static app:Strings.OpenSettingsFile}" Click="OnOpenSettingsFile" />
                            <TextBlock x:Name="VersionText" LineHeight="20" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- Across the card, under the version, so the Russian line isn't squeezed beside the link. -->
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Caption}" Margin="0,-4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
