<UserControl x:Class="Gengfu.App.Views.EventRow" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Gengfu.App">
    <UserControl.Resources>
        <!-- A card that opens, as Windows 11's own settings do: closed it shows the event's name and
             what it is; its header opens it to edit the event, under a divider. The header is the one
             tab stop, and Space or Enter opens and closes it. -->
        <Style x:Key="EventExpander" TargetType="Expander">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <DockPanel>
                                <ToggleButton x:Name="Header" DockPanel.Dock="Top" Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <ToggleButton.FocusVisualStyle>
                                        <!-- Drawn inside the header: the card's edge would cut one drawn around it. -->
                                        <Style>
                                            <Setter Property="Control.Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <Border Margin="2" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}">
                                                            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.FocusVisualStyle>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Chrome" MinHeight="66" Padding="16,12,10,12" CornerRadius="7" Background="Transparent">
                                                <DockPanel>
                                                    <Path x:Name="Chevron" DockPanel.Dock="Right" Width="12" Height="12" Margin="12,0,8,0" Data="M3,4.5 L6,7.5 L9,4.5"
                                                          Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Data" Value="M3,7.5 L6,4.5 L9,7.5" />
                                                    <Setter TargetName="Chrome" Property="CornerRadius" Value="7,7,0,0" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="Body" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
                                    <ContentPresenter />
                                </Border>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Expander x:Name="Row" Style="{StaticResource EventExpander}">
        <Expander.Header>
            <StackPanel>
                <TextBlock x:Name="Title" LineHeight="20" TextTrimming="CharacterEllipsis" />
                <!-- What it is, or a caution with what is wrong. -->
                <DockPanel>
                    <Canvas x:Name="SummaryMark" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,2.74,6,0" VerticalAlignment="Top">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                        <Path Data="M6,3.2 L6,6.8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        <Ellipse Width="1.6" Height="1.6" Canvas.Left="5.2" Canvas.Top="8.2" Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="Summary" FontSize="12" LineHeight="16" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Expander.Header>

        <StackPanel Margin="16">
            <TextBlock Style="{StaticResource Label}" Text="{x:Static app:Strings.EventNameLabel}" />
            <!-- Tab follows the tree, so the name comes before the bin. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" AutomationProperties.Name="{x:Static app:Strings.EventNameLabel}" TextChanged="OnNameChanged" />
                <TextBlock x:Name="NamePlaceholder" Style="{StaticResource Placeholder}" Text="{x:Static app:Strings.Jungle}" />
                <Button x:Name="RemoveButton" Grid.Column="1" Style="{StaticResource SubtleButton}" Width="32" Padding="0" Margin="8,0,0,0"
                        ToolTip="{x:Static app:Strings.RemoveEvent}" Click="OnRemove">
                    <Path Style="{StaticResource Icon}"
                          Data="M2.5,4.5 L13.5,4.5 M6,4.5 L6,3 A1,1 0 0 1 7,2 L9,2 A1,1 0 0 1 10,3 L10,4.5 M4,4.5 L4.7,13.1 A1,1 0 0 0 5.7,14 L10.3,14 A1,1 0 0 0 11.3,13.1 L12,4.5 M6.75,7 L6.75,11.5 M9.25,7 L9.25,11.5" />
                </Button>
            </Grid>

            <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4" Text="{x:Static app:Strings.SpawnTimes}" />
            <Grid>
                <TextBox x:Name="SpawnsBox" AutomationProperties.Name="{x:Static app:Strings.SpawnTimes}"
                         TextChanged="OnSpawnsChanged" KeyDown="OnSpawnsKey" LostKeyboardFocus="OnSpawnsLeft" />
                <TextBlock x:Name="SpawnsPlaceholder" Style="{StaticResource Placeholder}" Text="{x:Static app:Strings.SpawnsPlaceholder}" />
            </Grid>
            <Border x:Name="SpawnsBar" Style="{StaticResource CautionBar}" Margin="0,12,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Canvas DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                        <Path Data="M8,4.5 L8,8.75" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        <Ellipse Width="1.9" Height="1.9" Canvas.Left="7.05" Canvas.Top="10.15" Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="SpawnsBarText" Style="{StaticResource BarText}" />
                </DockPanel>
            </Border>

            <StackPanel x:Name="WordsPanel">
                <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4" Text="{x:Static app:Strings.Say}" />
                <!-- Long words wrap, so a long Russian call shows whole. -->
                <TextBox x:Name="WordsBox" TextWrapping="Wrap" AutomationProperties.Name="{x:Static app:Strings.Say}" TextChanged="OnWordsChanged" />
            </StackPanel>
            <StackPanel x:Name="FilePanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4" Text="{x:Static app:Strings.SoundFile}" />
                <DockPanel>
                    <Button x:Name="ChangeFile" DockPanel.Dock="Right" Height="32" Padding="12,0" Margin="8,0,0,0" Content="{x:Static app:Strings.Change}" Click="OnChooseFile" />
                    <Border x:Name="FileBox" Height="32" Padding="10,0" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <DockPanel VerticalAlignment="Center">
                            <Path DockPanel.Dock="Left" Style="{StaticResource Icon}"
                                  Data="M6,12 L6,3.5 L13,2 L13,10.5 M2.5,12 A1.75,1.75 0 1 0 6,12 A1.75,1.75 0 1 0 2.5,12 M9.5,10.5 A1.75,1.75 0 1 0 13,10.5 A1.75,1.75 0 1 0 9.5,10.5" />
                            <TextBlock x:Name="FileName" Style="{StaticResource IconLabel}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                </DockPanel>
            </StackPanel>
            <!-- What its calls play in place of what they were given, and why. -->
            <Border x:Name="SoundBar" Style="{StaticResource CautionBar}" Margin="0,12,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Canvas DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                        <Path Data="M8,4.5 L8,8.75" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        <Ellipse Width="1.9" Height="1.9" Canvas.Left="7.05" Canvas.Top="10.15" Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="SoundBarText" Style="{StaticResource BarText}" />
                </DockPanel>
            </Border>

            <DockPanel Margin="0,12,0,0">
                <Button x:Name="TestButton" DockPanel.Dock="Left" Style="{StaticResource ContentButton}" Padding="12,0" Click="OnTest">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="M2.5,6 L5,6 L8.5,3 L8.5,13 L5,10 L2.5,10 Z M11,5.5 A3.5,3.5 0 0 1 11,10.5" />
                        <TextBlock x:Name="TestText" Style="{StaticResource IconLabel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SoundSwitch" Style="{StaticResource LinkButton}" Height="32" HorizontalAlignment="Right" Click="OnSoundSwitch" />
            </DockPanel>
            <!-- Under the Test call pressed, as the main window's status line is out of sight here. -->
            <Border x:Name="NobodyHeardBar" Style="{StaticResource CautionBar}" Margin="0,12,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Canvas DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                        <Path Data="M8,4.5 L8,8.75" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        <Ellipse Width="1.9" Height="1.9" Canvas.Left="7.05" Canvas.Top="10.15" Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Canvas>
                    <TextBlock x:Name="NobodyHeardText" Style="{StaticResource BarText}" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Expander>
</UserControl>
