{
  "permissions": {
    "allow": [
      "Bash(lifecycle board:*)",
      "Bash(lifecycle doctor:*)",
      "Bash(lifecycle config:*)",
      "Bash(lifecycle upgraded:*)",
      "Bash(lifecycle guides check:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "lifecycle-kit": {
      "source": {
        "source": "github",
        "repo": "orwir/lifecycle-kit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "lifecycle@lifecycle-kit": true
  }
}
