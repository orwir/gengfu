#!/usr/bin/env bash
# Commit stage: quick checks on staged files only. The full gate runs on push (scripts/check.sh).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
. scripts/dotnet.sh

# Every staged change but a deletion: a rename with edits must reach the checks below too.
staged="$(git diff --cached --name-only --diff-filter=d)"
[ -n "$staged" ] || exit 0

# Large-file guard: nothing over 1 MB enters history.
while IFS= read -r file; do
    if [ -f "$file" ] && [ "$(wc -c <"$file")" -gt 1048576 ]; then
        echo "pre-commit: $file is over 1 MB" >&2
        exit 1
    fi
done <<<"$staged"

# Whitespace and layout of staged C# files (vendored lib/ excluded).
cs="$(grep -E '\.cs$' <<<"$staged" | grep -v '^lib/' || true)"
if [ -n "$cs" ]; then
    # shellcheck disable=SC2086
    "$DOTNET" format whitespace Gengfu.slnx --verify-no-changes --include $cs
fi

# Secret scan; CI always runs it. A missing gitleaks says so, so a skipped scan is never silent.
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --pre-commit --staged --redact --verbose --no-banner
else
    echo "pre-commit: gitleaks was not found on this shell's PATH, so the secret scan did not run." >&2
    echo "pre-commit: install it (CONTRIBUTING.md, Local setup), or restart a shell or app opened before the install." >&2
fi
